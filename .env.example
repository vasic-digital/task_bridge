# task_bridge — consumer-injected configuration template (§11.4.10).
#
# Copy to a gitignored `.env` in the CONSUMING project (NEVER in this submodule)
# and fill in real values. This file contains PLACEHOLDERS ONLY — never commit
# real credentials. task_bridge reads these from the environment at runtime and
# NEVER prints the token value.
#
# DECOUPLING (§11.4.28): task_bridge ships zero project-specific values. The
# consumer supplies its own token + board/folder URLs here.

# ClickUp personal API token (begins with pk_, never expires). Required.
# Header sent is literally `Authorization: <token>` (NOT Bearer) — see P0 §1.1.
CLICKUP_API_KEY=pk_REPLACE_WITH_YOUR_PERSONAL_TOKEN

# ClickUp folder URL (the board's folder). Resolved to a folder ID at runtime
# by an API probe (P0 §1.6 — no URL-grammar guessing). Required (or CLICKUP_BOARD).
CLICKUP_FOLDER=https://app.clickup.com/REPLACE/v/o/f/REPLACE

# ClickUp board/list URL. Resolved to a list ID at runtime by an API probe.
CLICKUP_BOARD=https://app.clickup.com/REPLACE/v/li/REPLACE

# Path to the consumer's workable-items SQLite SSoT (§11.4.93/.95).
TASK_BRIDGE_DB=docs/workable_items.db

# The custom-field name used as the immutable cross-system item key.
# Each consumer sets its own (e.g. a ticket-id custom field). Injected, generic
# — not hardcoded in the engine.
TASK_BRIDGE_ITEM_KEY=ITEM_ID
